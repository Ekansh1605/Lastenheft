# ===== LLM Providers =====
# Primary API LLM (used by default for generation)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Local LLM via Ollama (sovereignty option — exposed via dashboard toggle)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# ===== Database =====
# Local Postgres + pgvector (via docker compose)
DATABASE_URL=postgresql://lastenheft:lastenheft@localhost:5433/lastenheft   # host 5433 to avoid clash with system postgres

# ===== Auth (Supabase) =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Observability =====
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# ===== ML Service =====
ML_API_URL=http://localhost:8000
COLQWEN_MODEL=vidore/colqwen2-v1.0
COLPALI_FALLBACK=vidore/colpali-v1.3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CHECKPOINT=./models/reranker-lora

# ===== App config =====
APP_NAME=Lastenheft
APP_ENV=development
LOG_LEVEL=info
DEFAULT_LLM_PROVIDER=anthropic
PII_DETECTION_ENABLED=false

# ===== AI Act compliance =====
COMPLIANCE_AUDIT_LOG_RETENTION_DAYS=2555
DATA_RESIDENCY_REGION=eu-central-1
